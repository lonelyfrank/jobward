{
  "name": "meet-roulette",
  "version": "0.0.0",
  "private": true,
  "description": "Meet Roulette — il workspace del candidato per organizzare la ricerca del lavoro.",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @meet-roulette/api --filter @meet-roulette/web dev",
    "dev:api": "pnpm --filter @meet-roulette/api dev",
    "dev:web": "pnpm --filter @meet-roulette/web dev",
    "build": "pnpm --filter @meet-roulette/web build && pnpm --filter @meet-roulette/api build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @meet-roulette/web test:e2e",
    "db:generate": "pnpm --filter @meet-roulette/database generate",
    "db:migrate:local": "pnpm --filter @meet-roulette/api db:migrate:local",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:contrast && pnpm check:config && pnpm db:check && pnpm test && pnpm build",
    "check:contrast": "node scripts/check-contrast.mjs > /dev/null && echo \"Contrasto WCAG dei token: OK\" || (node scripts/check-contrast.mjs | grep FAIL; exit 1)",
    "test:preview": "pnpm --filter @meet-roulette/web test:preview",
    "db:check": "node scripts/check-migrations.mjs",
    "check:config": "node scripts/check-config.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "catalog:",
    "typescript-eslint": "8.72.1"
  }
}
