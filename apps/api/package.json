{
  "name": "@jobward/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "build": "wrangler deploy --dry-run --outdir dist --env \"\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --env dev",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@jobward/database": "workspace:*",
    "@jobward/schemas": "workspace:*",
    "@jobward/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "jose": "6.2.15",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.1",
    "@cloudflare/workers-types": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.157.0"
  }
}
